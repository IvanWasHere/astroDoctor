---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hills from '../components/Hills.astro';
import OpenStatus from '../components/OpenStatus.astro';
import HoursTable from '../components/HoursTable.astro';
import { site, team, services, directionsLink, mapsLink, phoneFor } from '../data/site';
import { routes, fmtDate, type Lang } from '../i18n';
import { getNews, newsUrl } from '../i18n/news';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const phone = phoneFor(lang);
const r = (k: keyof typeof routes) => routes[k][lang];
const news = (await getNews(lang)).slice(0, 3);

const c = {
  de: {
    eyebrow: 'Hausarztpraxis in Lehrte-Immensen',
    h1: 'Hausärztliche Versorgung für die ganze Familie.',
    lead: 'Dr. med. Ilsemarie Horst, Renke Harms und Team begleiten Kinder, Erwachsene und Senioren – persönlich, wertschätzend und mitten im Ort.',
    ctaContact: 'Kontakt & Rezepte',
    glance: 'Praxis auf einen Blick',
    route: 'Route planen',
    access: 'Barrierefrei',
    accessText: 'Erdgeschoss, Parkplätze direkt vor Ort',
    fax: 'Fax',
    quick: [
      { href: site.phoneHref, icon: 'calendar', title: 'Termin vereinbaren', text: `Telefonisch unter ${phone}` },
      { href: `${r('contact')}#rezept`, icon: 'pill', title: 'Rezept anfordern', text: 'Folgerezepte bequem online bestellen' },
      { href: r('hours'), icon: 'clock', title: 'Sprechzeiten', text: 'Wann wir für Sie da sind' },
      { href: r('services'), icon: 'pulse', title: 'Leistungen', text: 'Von Vorsorge bis Wundversorgung' },
    ],
    welcomeEyebrow: 'Herzlich willkommen',
    welcomeH: 'Ihre Hausarztpraxis mitten in Immensen.',
    welcomeLead:
      'Wir behandeln als Hausärztinnen und Hausärzte Kinder, Erwachsene und Senioren – unabhängig von Geschlecht, Herkunft, religiöser Ausrichtung oder sexueller Orientierung.',
    welcomeText:
      'Unsere erfahrenen Mitarbeiterinnen sind zum Teil schon seit Jahrzehnten in der Praxis. Wir bieten die hausarztzentrierte Versorgung der großen gesetzlichen Krankenkassen an und bilden selbst Medizinische Fachangestellte sowie Hausärztinnen und Hausärzte aus.',
    apptStrong: 'Unsere Sprechstunde ist terminbasiert.',
    apptText: 'Bitte vereinbaren Sie vor Ihrem Besuch einen Termin.',
    morePractice: 'Mehr über unsere Praxis →',
    teamEyebrow: 'Ärztinnen & Ärzte',
    teamH: 'Unser ärztliches Team',
    teamAll: 'Ganzes Team',
    svcEyebrow: 'Leistungen',
    svcH: 'Was wir für Sie tun',
    svcAll: 'Alle Leistungen',
    hoursEyebrow: 'Öffnungszeiten',
    hoursH: 'Wann wir für Sie da sind',
    hoursText: 'Die ärztliche Sprechstunde beginnt um 8:00 Uhr. Außerhalb unserer Zeiten erreichen Sie den ärztlichen Bereitschaftsdienst unter',
    hoursOr: ', im Notfall die',
    map: 'Auf der Karte ansehen →',
    newsEyebrow: 'Aktuelles',
    newsH: 'Neuigkeiten aus der Praxis',
    newsAll: 'Alle Meldungen',
  },
  en: {
    eyebrow: 'Family doctors in Lehrte-Immensen',
    h1: 'Family medicine for the whole family.',
    lead: 'Dr. med. Ilsemarie Horst, Renke Harms and their team care for children, adults and seniors – personally, respectfully and right in the village.',
    ctaContact: 'Contact & prescriptions',
    glance: 'The practice at a glance',
    route: 'Get directions',
    access: 'Step-free access',
    accessText: 'Ground floor, parking right outside',
    fax: 'Fax',
    quick: [
      { href: site.phoneHref, icon: 'calendar', title: 'Book an appointment', text: `By phone: ${phone}` },
      { href: `${r('contact')}#rezept`, icon: 'pill', title: 'Request a prescription', text: 'Order repeat prescriptions online' },
      { href: r('hours'), icon: 'clock', title: 'Opening hours', text: 'When we are here for you' },
      { href: r('services'), icon: 'pulse', title: 'Services', text: 'From check-ups to wound care' },
    ],
    welcomeEyebrow: 'Welcome',
    welcomeH: 'Your family practice in the heart of Immensen.',
    welcomeLead:
      'As family doctors we treat children, adults and seniors – regardless of gender, origin, religion or sexual orientation.',
    welcomeText:
      'Some of our experienced staff have been with the practice for decades. We take part in the GP-centred care programmes of the major statutory health insurers, and we train medical assistants and future family doctors ourselves.',
    apptStrong: 'We see patients by appointment.',
    apptText: 'Please book an appointment before your visit.',
    morePractice: 'More about our practice →',
    teamEyebrow: 'Our doctors',
    teamH: 'Meet our doctors',
    teamAll: 'Whole team',
    svcEyebrow: 'Services',
    svcH: 'How we can help',
    svcAll: 'All services',
    hoursEyebrow: 'Opening hours',
    hoursH: 'When we are here for you',
    hoursText: 'Doctors’ consultations start at 8:00. Outside our opening hours, call the on-call medical service on',
    hoursOr: ', or',
    map: 'View on map →',
    newsEyebrow: 'News',
    newsH: 'News from the practice',
    newsAll: 'All news',
  },
}[lang];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <div class="hero-cta">
          <a href={site.phoneHref} class="btn btn-primary"><Icon name="phone" size={18} /> {phone}</a>
          <a href={r('contact')} class="btn btn-ghost">{c.ctaContact} <Icon name="arrow" size={18} /></a>
        </div>
      </div>

      <aside class="hero-card" aria-label={c.glance}>
        <OpenStatus variant="light" />
        <ul class="facts">
          <li>
            <Icon name="pin" />
            <div>
              <strong>{site.street}</strong>
              <span>{site.zip} {site.city}</span>
              <a href={directionsLink} target="_blank" rel="noopener">{c.route}</a>
            </div>
          </li>
          <li>
            <Icon name="phone" />
            <div>
              <strong><a href={site.phoneHref}>{phone}</a></strong>
              <span>{c.fax} {lang === 'en' ? site.faxIntl : site.fax}</span>
            </div>
          </li>
          <li>
            <Icon name="access" />
            <div>
              <strong>{c.access}</strong>
              <span>{c.accessText}</span>
            </div>
          </li>
        </ul>
      </aside>
    </div>
    <Hills />
  </section>

  <section class="quick-wrap">
    <div class="wrap quick">
      {
        c.quick.map((q) => (
          <a href={q.href} class="quick-item">
            <span class="quick-icon">
              <Icon name={q.icon} />
            </span>
            <span>
              <strong>{q.title}</strong>
              <span class="muted">{q.text}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{c.welcomeEyebrow}</span>
        <h2>{c.welcomeH}</h2>
      </div>
      <div>
        <p class="lead">{c.welcomeLead}</p>
        <p>{c.welcomeText}</p>
        <div class="notice">
          <Icon name="calendar" />
          <p><strong>{c.apptStrong}</strong> {c.apptText}</p>
        </div>
        <p style="margin-top:1.25rem"><a href={r('practice')}>{c.morePractice}</a></p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">{c.teamEyebrow}</span>
          <h2>{c.teamH}</h2>
        </div>
        <a href={r('team')} class="btn btn-ghost">{c.teamAll} <Icon name="arrow" size={18} /></a>
      </div>
      <div class="team-grid">
        {
          team.map((m) => (
            <article class="person">
              <span class="avatar" aria-hidden="true">
                {m.initials}
              </span>
              <h3>{m.name}</h3>
              <p class="muted">{m.role[lang]}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">{c.svcEyebrow}</span>
          <h2>{c.svcH}</h2>
        </div>
        <a href={r('services')} class="btn btn-ghost">{c.svcAll} <Icon name="arrow" size={18} /></a>
      </div>
      <div class="svc-grid">
        {
          services.slice(0, 6).map((s) => (
            <a href={`${r('services')}#${s.id}`} class="svc">
              <Icon name={s.icon} size={28} />
              <h3>{s.title[lang]}</h3>
              <p class="muted">{s.items ? s.items.slice(0, 3).map((i) => i[lang]).join(' · ') : s.text![lang].split('.')[0] + '.'}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{c.hoursEyebrow}</span>
        <h2>{c.hoursH}</h2>
        <p class="muted">
          {c.hoursText} <a href="tel:116117"><strong>116 117</strong></a>{c.hoursOr} <a href="tel:112"><strong>112</strong></a>.
        </p>
        <a class="map-card" href={mapsLink} target="_blank" rel="noopener">
          <Icon name="pin" size={28} />
          <span>
            <strong>{site.street}, {site.zip} {site.city}</strong>
            <span class="muted">{c.map}</span>
          </span>
        </a>
      </div>
      <HoursTable />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">{c.newsEyebrow}</span>
          <h2>{c.newsH}</h2>
        </div>
        <a href={r('news')} class="btn btn-ghost">{c.newsAll} <Icon name="arrow" size={18} /></a>
      </div>
      <div class="news-grid">
        {
          news.map((n) => (
            <a href={newsUrl(lang, n.slug)} class="news card">
              <time datetime={n.data.date.toISOString()}>{fmtDate(lang, n.data.date)}</time>
              <h3>{n.data.title}</h3>
              <p class="muted">{n.data.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(50rem 30rem at 90% 0%, var(--brand-soft), transparent 70%),
      radial-gradient(30rem 20rem at 0% 30%, var(--accent-soft), transparent 70%);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1.35fr 1fr;
    align-items: center;
    padding-bottom: 1.5rem;
  }
  .hero-text .lead {
    max-width: 34rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    box-shadow: var(--shadow);
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 1.1rem;
  }
  .facts li {
    display: flex;
    gap: 0.9rem;
  }
  .facts li > :global(svg) {
    flex: none;
    color: var(--brand);
    margin-top: 0.15rem;
  }
  .facts div {
    display: flex;
    flex-direction: column;
    line-height: 1.45;
  }
  .facts span {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .facts a {
    font-size: 0.95rem;
  }
  .facts strong a {
    font-size: inherit;
    text-decoration: none;
  }
  .hero :global(.hills) {
    margin-top: -1rem;
  }

  .quick-wrap {
    background: var(--brand);
    padding-block: 1rem;
  }
  .quick {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .quick-item {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.15rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.12);
    color: #fff;
    text-decoration: none;
    transition: background 0.15s;
  }
  .quick-item:hover {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .quick-item > span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }
  .quick-item .muted {
    color: #b9d3d0;
    font-size: 0.92rem;
  }
  .quick-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    background: var(--brand-contrast);
    color: var(--brand);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .alt {
    background: var(--surface-2);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    margin: 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .person {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.75rem;
    border: 1px solid var(--line);
  }
  .person h3 {
    margin-bottom: 0.35rem;
  }
  .person p {
    margin: 0;
    font-size: 0.95rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 1.1rem;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .svc {
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .svc:hover {
    border-color: var(--brand);
    color: var(--ink);
    transform: translateY(-2px);
  }
  .svc :global(svg) {
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .svc h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .svc p {
    margin: 0;
    font-size: 0.95rem;
  }

  .map-card {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 1.5rem;
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .map-card :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .map-card > span {
    display: flex;
    flex-direction: column;
  }
  .map-card .muted {
    font-size: 0.92rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
  }
  .news {
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s;
  }
  .news:hover {
    border-color: var(--brand);
    color: var(--ink);
  }
  .news time {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
  }
  .news h3 {
    margin: 0.4rem 0 0.5rem;
  }
  .news p {
    margin: 0;
    font-size: 0.97rem;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .split {
      grid-template-columns: 1fr;
    }
    .quick,
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .quick,
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
