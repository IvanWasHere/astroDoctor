---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { site, directionsLink, mapsLink, phoneFor, faxFor } from '../data/site';
import { routes, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const phone = phoneFor(lang);
const privacy = routes.privacy[lang];
const formsReady = Boolean(site.formEndpoint);

const c = {
  de: {
    title: 'Kontakt & Rezepte',
    description: `Kontakt zur Gemeinschaftspraxis Immensen, ${site.street}, ${site.zip} ${site.city}. Telefon ${site.phone}. Rezepte online anfordern.`,
    eyebrow: 'Kontakt',
    h1: 'So erreichen Sie uns',
    lead: 'Am schnellsten erreichen Sie uns telefonisch während der Öffnungszeiten.',
    phone: 'Telefon',
    fax: 'Fax',
    email: 'E-Mail',
    book: 'Termin online buchen',
    bookText: 'Auch Videosprechstunde',
    address: 'Adresse',
    offline: 'Die Online-Formulare sind derzeit noch nicht freigeschaltet. Bitte rufen Sie uns an:',
    contactH: 'Kontaktformular',
    contactText: 'Für Terminwünsche und allgemeine Fragen. Bitte schildern Sie keine akuten Beschwerden – rufen Sie in dringenden Fällen an.',
    contactSubject: 'Kontaktanfrage über die Website',
    name: 'Name',
    tel: 'Telefon',
    optional: '(optional)',
    message: 'Ihr Anliegen',
    consentA: 'Ich habe die',
    consentLink: 'Datenschutzerklärung',
    consentB: 'gelesen und stimme der Verarbeitung meiner Angaben zu.',
    send: 'Nachricht senden',
    rxH: 'Rezeptanforderung',
    rxText: 'Für Folgerezepte bekannter Dauermedikation. Abholung in der Praxis bzw. als E-Rezept auf Ihre Gesundheitskarte.',
    rxSubject: 'Rezeptanforderung über die Website',
    fullName: 'Name, Vorname',
    dob: 'Geburtsdatum',
    telBack: 'Telefon für Rückfragen',
    meds: 'Medikamente',
    medsHint: '(Name, Stärke, Packungsgröße)',
    rxSend: 'Rezept anfordern',
    dirH: 'Anfahrt',
    dirText: 'Die Praxis ist barrierefrei im Erdgeschoss zugänglich. Parkplätze sind in unmittelbarer Umgebung vorhanden.',
    route: 'Route planen',
  },
  en: {
    title: 'Contact & prescriptions',
    description: `Contact Gemeinschaftspraxis Immensen, ${site.street}, ${site.zip} ${site.city}, Germany. Phone ${site.phoneIntl}. Request prescriptions online.`,
    eyebrow: 'Contact',
    h1: 'How to reach us',
    lead: 'The quickest way to reach us is by phone during opening hours.',
    phone: 'Phone',
    fax: 'Fax',
    email: 'Email',
    book: 'Book online',
    bookText: 'Video consultations too',
    address: 'Address',
    offline: 'The online forms are not available yet. Please give us a call:',
    contactH: 'Contact form',
    contactText: 'For appointment requests and general questions. Please don’t describe acute symptoms here – call us if it is urgent.',
    contactSubject: 'Contact request via website (EN)',
    name: 'Name',
    tel: 'Phone',
    optional: '(optional)',
    message: 'Your message',
    consentA: 'I have read the',
    consentLink: 'privacy policy',
    consentB: 'and agree to my details being processed.',
    send: 'Send message',
    rxH: 'Prescription request',
    rxText: 'For repeat prescriptions of your regular medication. Collect from the practice or as an e-prescription on your health insurance card.',
    rxSubject: 'Prescription request via website (EN)',
    fullName: 'Full name',
    dob: 'Date of birth',
    telBack: 'Phone number for queries',
    meds: 'Medication',
    medsHint: '(name, strength, pack size)',
    rxSend: 'Request prescription',
    dirH: 'Getting here',
    dirText: 'The practice is on the ground floor with step-free access. There is parking close by.',
    route: 'Get directions',
  },
}[lang];

const consent = { a: c.consentA, link: c.consentLink, b: c.consentB };
---

<Base title={c.title} description={c.description}>
  <PageHead eyebrow={c.eyebrow} title={c.h1} lead={c.lead} />

  <section class="wrap contact-cards">
    <a href={site.phoneHref} class="card c-item">
      <Icon name="phone" size={26} />
      <span class="label">{c.phone}</span>
      <strong>{phone}</strong>
    </a>
    <a href={site.bookingUrl} target="_blank" rel="noopener" class="card c-item">
      <Icon name="calendar" size={26} />
      <span class="label">{c.book}</span>
      <strong>{c.bookText}</strong>
    </a>
    <div class="card c-item">
      <Icon name="fax" size={26} />
      <span class="label">{c.fax}</span>
      <strong>{faxFor(lang)}</strong>
    </div>
    {
      site.email && (
        <a href={`mailto:${site.email}`} class="card c-item">
          <Icon name="mail" size={26} />
          <span class="label">{c.email}</span>
          <strong>{site.email}</strong>
        </a>
      )
    }
    <a href={mapsLink} target="_blank" rel="noopener" class="card c-item">
      <Icon name="pin" size={26} />
      <span class="label">{c.address}</span>
      <strong>{site.street}, {site.zip} {site.city}</strong>
    </a>
  </section>

  <section class="wrap section forms">
    {
      !formsReady && (
        <div class="notice wide">
          <Icon name="alert" />
          <p>
            {c.offline} <a href={site.phoneHref}>{phone}</a>
          </p>
        </div>
      )
    }

    <form class="card form" id="formular" method="post" action={site.formEndpoint || undefined}>
      <h2>{c.contactH}</h2>
      <p class="muted">{c.contactText}</p>
      <input type="hidden" name="_subject" value={c.contactSubject} />
      <fieldset disabled={!formsReady}>
        <div class="row2">
          <label>{c.name}<input name="name" autocomplete="name" required /></label>
          <label>{c.tel}<input name="telefon" type="tel" autocomplete="tel" required /></label>
        </div>
        <label>{c.email} <span class="opt">{c.optional}</span><input name="email" type="email" autocomplete="email" /></label>
        <label>{c.message}<textarea name="nachricht" rows="5" required></textarea></label>
        <label class="check"
          ><input type="checkbox" name="datenschutz" required />
          <span>{consent.a} <a href={privacy}>{consent.link}</a> {consent.b}</span></label
        >
        <button class="btn btn-primary" type="submit">{c.send} <Icon name="arrow" size={18} /></button>
      </fieldset>
    </form>

    <form class="card form" id="rezept" method="post" action={site.formEndpoint || undefined}>
      <h2>{c.rxH}</h2>
      <p class="muted">{c.rxText}</p>
      <input type="hidden" name="_subject" value={c.rxSubject} />
      <fieldset disabled={!formsReady}>
        <div class="row2">
          <label>{c.fullName}<input name="name" autocomplete="name" required /></label>
          <label>{c.dob}<input name="geburtsdatum" type="date" autocomplete="bday" required /></label>
        </div>
        <label>{c.telBack}<input name="telefon" type="tel" autocomplete="tel" required /></label>
        <label>{c.meds} <span class="opt">{c.medsHint}</span><textarea name="medikamente" rows="4" required></textarea></label>
        <label class="check"
          ><input type="checkbox" name="datenschutz" required />
          <span>{consent.a} <a href={privacy}>{consent.link}</a> {consent.b}</span></label
        >
        <button class="btn btn-primary" type="submit">{c.rxSend} <Icon name="arrow" size={18} /></button>
      </fieldset>
    </form>
  </section>

  <section class="wrap">
    <div class="card directions">
      <div>
        <h2>{c.dirH}</h2>
        <p class="muted">{c.dirText}</p>
      </div>
      <a href={directionsLink} target="_blank" rel="noopener" class="btn btn-ghost">{c.route} <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .c-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    color: var(--ink);
  }
  a.c-item:hover {
    border-color: var(--brand);
    color: var(--ink);
  }
  .c-item :global(svg) {
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .forms {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .wide {
    grid-column: 1 / -1;
  }
  .form h2 {
    font-size: 1.5rem;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  fieldset:disabled {
    opacity: 0.6;
  }
  .row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .opt {
    font-weight: 400;
    color: var(--ink-soft);
  }
  input,
  textarea {
    display: block;
    margin-top: 0.35rem;
    font: inherit;
    font-weight: 400;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    width: 100%;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }
  .check {
    display: flex;
    gap: 0.6rem;
    font-weight: 400;
    font-size: 0.9rem;
    align-items: flex-start;
  }
  .check input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.2rem;
    padding: 0;
    flex: none;
    accent-color: var(--brand);
  }
  .form button {
    justify-self: start;
  }
  .directions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .directions p {
    margin: 0;
  }
  @media (max-width: 860px) {
    .forms {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .row2 {
      grid-template-columns: 1fr;
    }
  }
</style>
